@keyframes pop{from{transform:scale(.6);opacity:0}}
#lb{position:fixed;inset:0;display:grid;place-items:center;padding:16px;background:radial-gradient(circle at 30% 20%,#243569,#070b18 75%);z-index:8;overflow:auto}
#lb[hidden]{display:none}
#lb>div{background:var(--pn);padding:24px 26px;border-radius:20px;width:min(380px,100%);display:flex;flex-direction:column;gap:12px;border-top:6px solid #c8102e}
