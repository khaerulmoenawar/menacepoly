@media (max-width:820px){#app{flex-direction:column;padding:8px;gap:8px}aside{width:auto;flex:0 0 auto;height:40%}#pl{grid-template-columns:repeat(4,1fr)}.pc{padding:4px 6px;font-size:11px}h1{display:none}}
